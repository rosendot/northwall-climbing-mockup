---
/** Compact interior-page hero with a breadcrumb trail above the title. */
interface Props {
  title: string;
  intro: string;
  current: string;
}

const { title, intro, current } = Astro.props;
---

<section class="page-hero">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span class="sep" aria-hidden="true">/</span>
      <span class="here" aria-current="page">{current}</span>
    </nav>
    <h1>{title}</h1>
    <p class="lede">{intro}</p>
  </div>
</section>
